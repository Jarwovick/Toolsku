<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin untuk menampilkan overlay di atas aplikasi lain -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Izin untuk melihat daftar semua aplikasi -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Izin untuk membaca ukuran cache/data aplikasi -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Izin untuk mematikan background process (fallback) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Izin untuk mengunci rotasi saat otomasi -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".ToolskuApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Toolsku"
        tools:targetApi="34">

        <!-- Home -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Toolsku">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding izin -->
        <activity
            android:name=".onboarding.PermissionActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Modul Peredupan -->
        <activity
            android:name=".dimmer.DimmerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Modul Hentikan Aplikasi -->
        <activity
            android:name=".killer.KillerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".killer.ExceptionActivity"
            android:exported="false"
            android:parentActivityName=".killer.KillerActivity" />

        <!-- Modul Bersihkan Cache -->
        <activity
            android:name=".cleaner.CleanerActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Modul Boot Menu -->
        <activity
            android:name=".boot.BootActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Quick Action (untuk shortcut) -->
        <activity
            android:name=".shortcut.QuickActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Toolsku.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service (inti otomasi) -->
        <service
            android:name=".automation.AutomationAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Overlay blocker service -->
        <service
            android:name=".overlay.BlockerOverlayService"
            android:exported="false" />

    </application>

</manifest>
